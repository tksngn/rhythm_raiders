<div class="member-track-show">
  <div class="form-page__inner">
    <div class="hero-logo">
      <%= image_tag("rhythm_raiders_logo2.jpg", alt: "Rhythm Raiders") %>
    </div>

    <section class="form-card">
      <h2 class="about-heading">§ Edit Track §</h2>

      <p class="auth-hint mb-3">
        「<%= @created_track.music_title %>」の情報を編集できます。
        音源ファイルは差し替えできません（別の曲として投稿してください）。
      </p>

      <%= form_with model: [:member, @created_track], html: { class: "auth-form" } do |f| %>
        <%= render 'layouts/errors', model: @created_track %>
        <div class="auth-field">
          <%= f.label :music_title, "Music Title" %>
          <%= f.text_field :music_title, class: "auth-input" %>
        </div>
        <div class="auth-field">
          <%= f.label :music_genre, "Music Genre" %>
          <%= f.text_field :music_genre, class: "auth-input" %>
        </div>
        <div class="auth-field">
          <%= f.label :creater_word, "Creator Word" %>
          <%= f.text_area :creater_word, rows: 4, class: "auth-input" %>
        </div>
        <div class="auth-field">
          <%= f.label :music_image, "AI Artwork（任意）" %>
          <%= f.file_field :music_image, accept: "image/png,image/jpeg,image/gif,image/webp", class: "auth-input auth-input--file" %>
          <p class="auth-hint">
            AIで生成したジャケット画像。PNG / JPEG / GIF / WebP、5MBまで。
            選び直すと差し替わります。
          </p>

          <% if @created_track.music_image.attached? %>
            <div class="ts-artwork__frame ts-artwork__frame--preview mt-2">
              <%= image_tag @created_track.music_image, alt: "#{@created_track.music_title} のAI静止画" %>
            </div>
            <p class="auth-hint mt-2">
              <%= check_box_tag "created_track[remove_music_image]", "1", false, id: "remove_music_image" %>
              <%= label_tag "remove_music_image", "この画像を削除する" %>
            </p>
          <% end %>
        </div>
        <div class="auth-field">
          <%= f.label :music_video_url, "AI Music Video URL" %>
          <%= f.url_field :music_video_url, class: "auth-input", placeholder: "https://www.youtube.com/watch?v=..." %>
          <p class="auth-hint">
            動画をYouTube／VimeoにアップロードしてURLを貼ってください。
            <strong>YouTube・Vimeoの動画URLであれば何でも埋め込めます</strong>（制作ツールは問いません）。
            空欄にして保存すると、動画の紐づけを解除できます。
          </p>
        </div>
        <%= f.submit "Save / 保存", class: "neon-btn neon-btn--primary auth-submit" %>
      <% end %>

      <% if (embed_url = @created_track.music_video_embed_url) %>
        <div class="ts-mv mt-4">
          <h3 class="ts-mv__label">現在のAI動画</h3>
          <div class="ts-mv__frame">
            <iframe src="<%= embed_url %>"
                    title="<%= @created_track.music_title %> のミュージックビデオ"
                    loading="lazy"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen></iframe>
          </div>
        </div>
      <% end %>
    </section>

    <%= link_to "← 楽曲ページに戻る", member_created_track_path(@created_track), class: "neon-btn neon-btn--ghost hero-logout" %>
  </div>
</div>
